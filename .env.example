# IQ Scaffold Gateway Service Environment Variables Template
# Copy this file to .env.local, .env.uat, or .env.prd and configure values

# =============================================================================
# Redis Cache Configuration (iqscaffold.cache.redis prefix)
# =============================================================================
IQSCAFFOLD_CACHE_REDIS_HOST=localhost
IQSCAFFOLD_CACHE_REDIS_PORT=6379
IQSCAFFOLD_CACHE_REDIS_PASSWORD=
IQSCAFFOLD_CACHE_REDIS_DATABASE=0

# =============================================================================
# Gateway Routing Configuration (iqscaffold.gateway.routing prefix)
# =============================================================================
IQSCAFFOLD_GATEWAY_ROUTING_USER_SERVICE_URI=http://localhost:8080
IQSCAFFOLD_GATEWAY_ROUTING_BILLING_SERVICE_URI=http://iqscaffold-billing-service:8080
IQSCAFFOLD_GATEWAY_ROUTING_CONTACT_SERVICE_URI=http://iqscaffold-contact-service:8080
IQSCAFFOLD_GATEWAY_ROUTING_LEAD_SERVICE_URI=http://lead-service:8080
IQSCAFFOLD_GATEWAY_ROUTING_PIPELINE_SERVICE_URI=http://pipeline-service:8080

# API Prefix Configuration
# Local/Staging: Use /api prefix (e.g., http://localhost:8080/api/v1/auth/login)
# Production: Use empty prefix when deployed on api.iqscaffold.com (e.g., https://api.iqscaffold.com/v1/auth/login)
# IQSCAFFOLD_GATEWAY_ROUTING_API_PREFIX_PREFIX=/api
# IQSCAFFOLD_GATEWAY_ROUTING_API_PREFIX_STRIP_COUNT=0

# =============================================================================
# Gateway Security Configuration
# =============================================================================
JWT_SECRET_KEY=your-jwt-secret-key-change-in-production
IQSCAFFOLD_GATEWAY_SECURITY_USER_SERVICE_URL=http://localhost:8080
USER_SERVICE_JWK_URI=http://localhost:8080/.well-known/jwks.json

# =============================================================================
# Gateway CORS Configuration (iqscaffold.gateway.cors prefix)
# =============================================================================
IQSCAFFOLD_GATEWAY_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# =============================================================================
# Observability Configuration (iqscaffold.observability prefix)
# =============================================================================
IQSCAFFOLD_OBSERVABILITY_TRACING_ENDPOINT=http://localhost:4317

# =============================================================================
# Spring Profile Configuration
# =============================================================================
SPRING_PROFILES_ACTIVE=local,crm

# =============================================================================
# Environment-Specific Examples
# =============================================================================

# Local Development Environment
# SPRING_PROFILES_ACTIVE=local,crm
# IQSCAFFOLD_GATEWAY_ROUTING_USER_SERVICE_URI=http://localhost:8080
# IQSCAFFOLD_CACHE_REDIS_HOST=localhost
# JWT_SECRET_KEY=local-development-secret-key-not-for-production-use
# USER_SERVICE_JWK_URI=http://localhost:8080/.well-known/jwks.json
# IQSCAFFOLD_GATEWAY_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8080

# Staging Environment
# SPRING_PROFILES_ACTIVE=uat,crm
# IQSCAFFOLD_GATEWAY_ROUTING_USER_SERVICE_URI=http://iqscaffold-user-service:8080
# IQSCAFFOLD_CACHE_REDIS_HOST=staging-redis
# JWT_SECRET_KEY=${VAULT_JWT_SECRET}
# USER_SERVICE_JWK_URI=http://iqscaffold-user-service/.well-known/jwks.json
# IQSCAFFOLD_GATEWAY_CORS_ALLOWED_ORIGINS=https://iqscaffold.website

# Production Environment (deployed on api.iqscaffold.com)
# SPRING_PROFILES_ACTIVE=prd,crm
# IQSCAFFOLD_GATEWAY_ROUTING_USER_SERVICE_URI=http://iqscaffold-user-service:8080
# API_STRIP_COUNT=0
# IQSCAFFOLD_CACHE_REDIS_HOST=prod-redis
# JWT_SECRET_KEY=${VAULT_JWT_SECRET}
# USER_SERVICE_JWK_URI=http://iqscaffold-user-service/.well-known/jwks.json
# IQSCAFFOLD_GATEWAY_CORS_ALLOWED_ORIGINS=https://app.iqscaffold.com
