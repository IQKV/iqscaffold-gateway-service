# Production Environment Variables for Gateway Service
SPRING_PROFILES_ACTIVE=production,crm

# Redis Configuration
IQSCAFFOLD_CACHE_REDIS_HOST=${REDIS_HOST}
IQSCAFFOLD_CACHE_REDIS_PORT=6379
IQSCAFFOLD_CACHE_REDIS_PASSWORD=${REDIS_PASSWORD}
IQSCAFFOLD_CACHE_REDIS_DATABASE=2

# Gateway Routing Configuration
IQSCAFFOLD_GATEWAY_ROUTING_USER_SERVICE_URI=http://iqscaffold-user-service:8080
IQSCAFFOLD_GATEWAY_ROUTING_BILLING_SERVICE_URI=http://iqscaffold-billing-service:8080
IQSCAFFOLD_GATEWAY_ROUTING_CONTACT_SERVICE_URI=http://iqscaffold-contact-service:8080
IQSCAFFOLD_GATEWAY_ROUTING_LEAD_SERVICE_URI=http://lead-service:8080
IQSCAFFOLD_GATEWAY_ROUTING_PIPELINE_SERVICE_URI=http://pipeline-service:8080

# Gateway Security Configuration
JWT_SECRET_KEY=${JWT_SECRET}
IQSCAFFOLD_GATEWAY_SECURITY_USER_SERVICE_URL=http://iqscaffold-user-service:8080
USER_SERVICE_JWK_URI=http://iqscaffold-user-service/.well-known/jwks.json

# Gateway CORS Configuration
IQSCAFFOLD_GATEWAY_CORS_ALLOWED_ORIGINS=${ALLOWED_ORIGINS}

# Observability Configuration
IQSCAFFOLD_OBSERVABILITY_TRACING_ENDPOINT=${OTEL_EXPORTER_OTLP_ENDPOINT}
